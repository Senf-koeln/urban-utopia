{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": ".",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2023",
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "compileOnSave": true,
  "include": [
    "src/index.ts",
    "src/gemini.ts",
    "src/onUtopiaContactRequest.ts",
    "src/lib/slackWebhook.ts",
    "src/lib/slackMrkdwn.ts"
  ]
}
