{
  "name": "urban-utopia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "kill-port 5173 8082 >/dev/null 2>&1 && (yarn tokens:dev & yarn server:dev & yarn dev:web)",
    "dev:web": "dotenvx run -fk .env.keys -f $(node scripts/resolve-app-env-file.cjs) -- node ./node_modules/vite/bin/vite.js --host",
    "dev:plain": "node ./node_modules/vite/bin/vite.js --host",
    "dev:ngrok": "VITE_ENABLE_NGROK=true yarn dev",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "node server/build.mjs",
    "tokens:build": "npm run build --prefix tokens",
    "tokens:dev": "npm run dev --prefix tokens",
    "build": "yarn tokens:build && yarn build:web && yarn server:build",
    "vite:build": "NODE_OPTIONS=--max-old-space-size=8192 node ./node_modules/vite/bin/vite.js build",
    "build:web": "dotenvx run -fk .env.keys -f $(node scripts/resolve-app-env-file.cjs) -- yarn vite:build",
    "build:docker": "node -e \"process.env.APP_ENV||(console.error('ERROR: APP_ENV not set'),process.exit(1))\" && dotenvx run --strict --ignore=MISSING_ENV_FILE -fk .env.keys -f $(node scripts/resolve-app-env-file.cjs) -- yarn vite:build --mode $APP_ENV",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "secrets:encrypt": "node scripts/dotenvx-secrets.cjs encrypt --all",
    "secrets:decrypt": "node scripts/dotenvx-secrets.cjs decrypt --all",
    "deploy:functions": "firebase deploy --config cloudFunctions/firebase.json --project=urban-utopia-bc48d --only functions",
    "clean": "npx --yes del-cli node_modules dist server/dist .turbo --force"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@lottiefiles/dotlottie-react": "^0.17.6",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@unhead/react": "^2.1.10",
    "clsx": "^1.2.1",
    "dayjs": "^1.11.13",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "i18next": "^21.6.16",
    "i18next-browser-languagedetector": "^6.1.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.263.1",
    "mapbox": "^1.0.0-beta10",
    "mapbox-gl": "^3.15.0",
    "maska": "^3.2.0",
    "motion": "^12.40.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^11.16.7",
    "react-infinite-scroller": "^1.2.6",
    "react-inlinesvg": "^4.0.2",
    "react-intersection-observer-hook": "^2.1.1",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router-dom": "^6.3.0",
    "styled-components": "^5.3.5",
    "tailwind-merge": "^1.12.0",
    "tailwind-variants": "^0.1.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@biomejs/biome": "^2.5.0",
    "@dotenvx/dotenvx": "^1.71.0",
    "@mapbox/mapbox-sdk": "^0.13.7",
    "@react-spring/web": "^10.0.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/babel__core": "^7",
    "@types/express": "^5.0.6",
    "@types/mapbox-gl": "^3.4.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-infinite-scroller": "^1.2.3",
    "@types/react-lazy-load-image-component": "^1",
    "@types/styled-components": "^5.1.23",
    "@use-gesture/react": "^10.2.14",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-styled-components": "^2.1.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "esbuild": "^0.24.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.3.11",
    "postcss-import": "^14.0.2",
    "styled-system": "^5.1.5",
    "tailwindcss": "^3.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-ngrok": "^1.1.2"
  },
  "engines": {
    "node": "22.14.0",
    "yarn": "4.8.1"
  },
  "packageManager": "yarn@4.8.1",
  "resolutions": {
    "typescript": "^5.9.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "express": "^5.2.1",
    "@types/express": "^5.0.6"
  }
}
